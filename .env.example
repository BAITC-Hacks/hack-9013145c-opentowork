# ─── Приложение ─────────────────────────────────────────────────────────────
APP_NAME=hackalem-api
APP_ENV=dev                      # dev | staging | prod
APP_VERSION=0.1.0
DEBUG=true
# Создать демо-пользователя и демо-данные при старте. По умолчанию в коде
# ВЫКЛЮЧЕНО: пароль этой учётки опубликован в README. Здесь включено осознанно,
# потому что compose — это локальный стенд.
SEED_ON_START=true
DEMO_USER_ROLE=EXPERT            # НЕ ADMIN: ADMIN обходит проверку владельца
RUN_MIGRATIONS=true

# ─── База данных ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ─── Redis (кэш, очередь, rate limit) ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=ai_jobs
QUEUE_VISIBILITY_TIMEOUT=600     # сек; после — задача возвращается в обработку
QUEUE_MAX_LEN=100000             # поток подрезается, иначе Redis растёт до OOM
WORKER_CONCURRENCY=8             # задач одновременно на один под воркера
JOB_MAX_ATTEMPTS=3               # после — в поток несработавших задач
JOB_RECOVERY_INTERVAL_S=120      # как часто искать задачи, не попавшие в очередь

# ─── Object Storage (S3 / MinIO) ────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
MAX_FILE_SIZE_MB=20

# ─── LLM ────────────────────────────────────────────────────────────────────
# mock = работает без интернета и ключей (для проверки техническим экспертом)
LLM_MODE=mock                    # live | mock
LLM_PRIMARY=anthropic:claude-sonnet-5
LLM_FALLBACK=anthropic:claude-haiku-4-5-20251001
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048

# ─── Эмбеддинги ─────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=

# ─── Semantic Cache ─────────────────────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92    # ниже 0.85 — ложные срабатывания, выше 0.97 — кэш мёртв
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_MAX_ROWS=50000   # сверх этого воркер вытесняет самые холодные записи
EXACT_CACHE_TTL=3600
CACHE_PURGE_INTERVAL_S=300      # как часто воркер чистит протухшее
# Поля контекста, различающие запросы. ЗАПОЛНИТЬ ПОД КЕЙС!
# ВАЖНО: поле, по которому фильтруется retrieval (language, doc_kind),
# ОБЯЗАНО быть в этом списке — иначе кэш отдаст ответ, собранный по другим
# документам. Добавили фильтр — добавьте поле сюда.
CACHE_CONTEXT_FIELDS=language,region,doc_kind
# global — общий кэш на всю платформу (максимальный hit rate).
# user   — ключ включает владельца запроса. Переключить, как только в запросах
#          появятся персональные или коммерческие данные клиента.
# user — по умолчанию, ключ кэша включает владельца запроса.
# global — общий кэш, выше hit rate. Включать ТОЛЬКО если доказано, что ответы
# строятся исключительно на общедоступных документах.
SEMANTIC_CACHE_SCOPE=user

# ─── RAG ────────────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_TOP_K=5
RAG_CANDIDATES=20                # до реранжирования
RAG_MIN_SIMILARITY=0.5           # ниже — считаем, что знаний нет
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Размер списка кандидатов HNSW. Фильтр применяется ПОСЛЕ обхода индекса,
# поэтому при значении по умолчанию (40) фильтрованный поиск начинает
# промахиваться по мере роста таблицы — молча.
HNSW_EF_SEARCH=200
KNOWLEDGE_MAX_CHARS=500000       # документ индексируется синхронно в запросе

# ─── Валидация / Guardrails ─────────────────────────────────────────────────
VALIDATION_MAX_ATTEMPTS=2
INPUT_MAX_CHARS=8000
CONTEXT_MAX_CHARS=2000           # context тоже уходит в промпт, тоже ограничен
INJECTION_GUARD_ENABLED=true
PROMPT_VERSION=v1                # меняете промпт → меняете версию → кэш инвалидируется

# ─── Безопасность ───────────────────────────────────────────────────────────
# При APP_ENV != dev приложение НЕ СТАРТУЕТ со значением по умолчанию или
# короче 32 символов. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate limiting (запросов в минуту) ──────────────────────────────────────
RATE_LIMIT_ANON=20
RATE_LIMIT_USER=100
RATE_LIMIT_AI=20
RATE_LIMIT_LOGIN=10              # попыток входа в минуту на один email

# ─── Наблюдаемость ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
STATS_WINDOW_HOURS=24            # окно, за которое считается сводка /ai/stats

# ─── Демо-учётка (указать в README для техэкспертов) ────────────────────────
DEMO_USER_EMAIL=demo@demo.kz
DEMO_USER_PASSWORD=demo1234
